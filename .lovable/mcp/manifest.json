{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ugpjavgzqnqeoebyqvoa.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "educsme",
      "version": "0.1.0",
      "title": "educsme"
    },
    "tools": [
      {
        "name": "list_students",
        "title": "List students",
        "description": "List students visible to the signed-in user, optionally filtered by grade, section, status, or a name/email search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Match against name or email."
            },
            "grade": {
              "type": "string",
              "description": "Filter by grade."
            },
            "section": {
              "type": "string",
              "description": "Filter by section."
            },
            "status": {
              "type": "string",
              "description": "Filter by status, e.g. active."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_announcements",
        "title": "List announcements",
        "description": "List announcements visible to the signed-in user, newest first, optionally filtered by category or priority.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Filter by announcement category."
            },
            "priority": {
              "type": "string",
              "description": "Filter by priority, e.g. high."
            },
            "publishedOnly": {
              "type": "boolean",
              "default": true,
              "description": "Only return published announcements."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Max rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_announcement",
        "title": "Create announcement",
        "description": "Create a new announcement authored by the signed-in user. Requires permission to publish announcements.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Announcement title."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "description": "Announcement body text."
            },
            "category": {
              "type": "string",
              "default": "general",
              "description": "Announcement category."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "medium",
              "description": "Announcement priority."
            },
            "isPublished": {
              "type": "boolean",
              "default": false,
              "description": "Publish immediately or keep as draft."
            }
          },
          "required": [
            "title",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_study_materials",
        "title": "List study materials",
        "description": "List GCSE study materials, optionally filtered by subject or topic, ordered by their study-grid position.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "description": "Filter by subject."
            },
            "topic": {
              "type": "string",
              "description": "Filter by topic."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_documents",
        "title": "List documents",
        "description": "List documents in the CMS library visible to the signed-in user, newest first, optionally filtered by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Filter by document category."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
